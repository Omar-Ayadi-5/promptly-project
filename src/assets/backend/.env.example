# Copy this file to .env in the same directory and replace the placeholders.
# Never commit the completed .env file.

# MongoDB Atlas: URL-encode special characters in the username/password.
MONGO_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority

# OpenRouter API key (https://openrouter.ai/).
openrouter_key=replace-with-your-openrouter-api-key

# Use separate randomly generated values, each at least 32 characters long.
Token_secret_key=replace-with-a-random-token-signing-secret
ADMIN_SECRET_KEY=replace-with-a-different-random-admin-secret

# Email verification. Verify the sender configured in app/infrastructure/sendgrid.py.
SENDGRID_API_KEY=replace-with-your-sendgrid-api-key

# Voice transcription. The variable spelling matches the existing backend.
asembly_ai_key=replace-with-your-assemblyai-api-key

SENDGRID_FROM_EMAIL=verified-sender@example.com
# Optional comma-separated browser origins for a new deployment.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
